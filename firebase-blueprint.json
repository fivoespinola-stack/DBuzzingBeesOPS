{
  "entities": {
    "Task": {
      "title": "Task",
      "description": "A scheduled or completed cleaning job",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "jobType": { "type": "string" },
        "address": { "type": "string" },
        "clientNumber": { "type": "string" },
        "clientName": { "type": "string" },
        "clientPhone": { "type": "string" },
        "clientEmail": { "type": "string" },
        "clientMessenger": { "type": "string" },
        "clientPreferredChannel": { "type": "string" },
        "fixHour": { "type": "number" },
        "rate": { "type": "number" },
        "payType": { "type": "string" },
        "paymentTerm": { "type": "string" },
        "invoiceNumber": { "type": "string" },
        "assignedCleanerIds": { "type": "array" },
        "remarks": { "type": "string" },
        "specialInstructions": { "type": "string" },
        "date": { "type": "string" },
        "startTime": { "type": "string" },
        "endTime": { "type": "string" },
        "frequency": { "type": "string" },
        "completed": { "type": "boolean" },
        "createdAt": { "type": "string" },
        "isRecurring": { "type": "boolean" },
        "seriesId": { "type": "string" },
        "isApproved": { "type": "boolean" },
        "approvedBy": { "type": "string" },
        "approvedAt": { "type": "string" },
        "confirmationStatus": { "type": "string" },
        "confirmationDeliveryStatus": { "type": "string" },
        "confirmationRetryCount": { "type": "number" },
        "confirmationLastError": { "type": "string" },
        "lastConfirmationSentAt": { "type": "string" },
        "lastConfirmationChannel": { "type": "string" },
        "confirmationLogs": { "type": "array" }
      },
      "required": ["id", "jobType", "address", "date", "startTime", "endTime", "fixHour", "rate"]
    },
    "ConfirmationLog": {
      "title": "ConfirmationLog",
      "description": "Permanent audit record of a booking confirmation dispatch attempt",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "taskId": { "type": "string" },
        "clientName": { "type": "string" },
        "clientEmail": { "type": "string" },
        "clientPhone": { "type": "string" },
        "channel": { "type": "string" },
        "status": { "type": "string" },
        "deliveryStatus": { "type": "string" },
        "timestamp": { "type": "string" },
        "staffName": { "type": "string" },
        "recipient": { "type": "string" },
        "subject": { "type": "string" },
        "messagePreview": { "type": "string" },
        "fullMessage": { "type": "string" },
        "htmlContent": { "type": "string" },
        "retryCount": { "type": "number" },
        "lastError": { "type": "string" },
        "notes": { "type": "string" },
        "rescheduleUrl": { "type": "string" },
        "contactUrl": { "type": "string" },
        "serviceDate": { "type": "string" },
        "serviceTime": { "type": "string" }
      },
      "required": ["id", "taskId", "channel", "status", "timestamp"]
    },
    "Cleaner": {
      "title": "Cleaner",
      "description": "Cleaner staff profile and payment configuration",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "phone": { "type": "string" },
        "email": { "type": "string" },
        "hourlyRate": { "type": "number" },
        "specialTaskPayPerWeek": { "type": "number" },
        "status": { "type": "string" },
        "notes": { "type": "string" }
      },
      "required": ["id", "name", "hourlyRate", "status"]
    },
    "StaffUser": {
      "title": "StaffUser",
      "description": "Authenticated staff member account",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "username": { "type": "string" },
        "name": { "type": "string" },
        "role": { "type": "string" },
        "status": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "username", "name", "role", "status"]
    },
    "CompanySettings": {
      "title": "CompanySettings",
      "description": "DBuzzingBees business settings and templates",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "businessName": { "type": "string" },
        "contactPhone": { "type": "string" },
        "contactEmail": { "type": "string" },
        "facebookPage": { "type": "string" },
        "confirmationMessageTemplate": { "type": "string" },
        "confirmationSubjectTemplate": { "type": "string" },
        "enablePaidSms": { "type": "boolean" },
        "autoSendOnApproval": { "type": "boolean" },
        "primaryConfirmationChannel": { "type": "string" },
        "fallbackChannel": { "type": "string" },
        "maxEmailRetries": { "type": "number" },
        "reschedulePageUrl": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "businessName"]
    }
  },
  "firestore": {
    "/tasks/{taskId}": {
      "schema": "Task",
      "description": "All client cleaning schedules, tasks, and historical jobs"
    },
    "/confirmation_logs/{logId}": {
      "schema": "ConfirmationLog",
      "description": "Permanent dispatch logs of all sent, retried, and failed booking confirmations"
    },
    "/cleaners/{cleanerId}": {
      "schema": "Cleaner",
      "description": "Cleaner roster and pay rates"
    },
    "/staff_users/{userId}": {
      "schema": "StaffUser",
      "description": "Staff users and roles"
    },
    "/settings/{settingsId}": {
      "schema": "CompanySettings",
      "description": "Global company configuration and confirmation templates"
    }
  }
}
